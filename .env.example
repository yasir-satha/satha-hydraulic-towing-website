# Copy to .env for local testing, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Every tag is optional — leave a value empty and that tag simply won't load.

# Canonical domain used for canonical URLs, hreflang, sitemap and robots.txt (no trailing slash)
SITE_URL=https://www.your-domain.com

# Business phone number (any format: 0569470469, +966569470469, 966 56 947 0469)
PUBLIC_PHONE_NUMBER=0569470469
# Optional — only if WhatsApp is on a different number
PUBLIC_WHATSAPP_NUMBER=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=

# Google Analytics 4 — Measurement ID
# If GA4 is also set up as a tag inside GTM, leave this empty or page views are counted twice.
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads — Conversion ID and conversion labels (Google Ads → Goals → Conversions → Tag setup)
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CALL_LABEL=
PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
PUBLIC_GOOGLE_ADS_FORM_LABEL=

# Meta (Facebook / Instagram) Pixel ID
PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID
PUBLIC_TIKTOK_PIXEL_ID=

# Optional site verification tokens (content value only)
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (also feeds ChatGPT search and Microsoft Copilot)
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
