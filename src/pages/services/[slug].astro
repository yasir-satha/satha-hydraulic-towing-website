---
import LandingTemplate from '../../components/LandingTemplate.astro';
import { COLLECTIONS, getLandingProps } from '../../lib/landing';

export function getStaticPaths() {
  return COLLECTIONS.services.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<LandingTemplate {...getLandingProps('services', page, 'en')} />
