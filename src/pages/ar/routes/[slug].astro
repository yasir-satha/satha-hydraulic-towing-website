---
import RouteTemplate from '../../../components/RouteTemplate.astro';
import { ROUTES } from '../../../data/routes';

export function getStaticPaths() {
  return ROUTES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<RouteTemplate lang="ar" page={page} />
