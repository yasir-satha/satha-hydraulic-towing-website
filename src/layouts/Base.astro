---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactFloat from '../components/ContactFloat.astro';
import Analytics from '../components/Analytics.astro';
import { SITE, localePath, type Lang } from '../data/site';
import { UI } from '../data/ui';

interface Props {
  lang: Lang;
  /** Path WITHOUT the /ar prefix, with trailing slash, e.g. "/services/accident-recovery/" */
  path: string;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Pre-filled WhatsApp message for the floating/sticky buttons */
  wa?: string;
  /** Whether this page exists in both languages (for hreflang) */
  alternates?: boolean;
}

const { lang, path, title, description, schema = [], noindex = false, wa, alternates = true } = Astro.props;
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(localePath(lang, path));
const enUrl = abs(localePath('en', path));
const arUrl = abs(localePath('ar', path));
// Open Graph images exported from the design file (1200×630), one per language
const ogUrl = abs(lang === 'ar' ? '/og-ar.jpg' : '/og-en.jpg');
const t = UI[lang];
// Google Tag Manager container ID (only loads when PUBLIC_GTM_ID is set)
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';

const business = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  '@id': abs('/#business'),
  name: SITE.name.en,
  alternateName: [SITE.name.ar, 'Satha', 'سطحة'],
  description: UI.en.footer.blurb,
  url: abs('/'),
  telephone: SITE.phoneE164,
  image: abs('/og-en.jpg'),
  logo: abs('/icon-512.png'),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Riyadh',
    addressRegion: 'Riyadh Province',
    addressCountry: 'SA',
  },
  areaServed: [
    { '@type': 'City', name: 'Riyadh' },
    { '@type': 'Country', name: 'Saudi Arabia' },
  ],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  }],
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: SITE.phoneE164,
    contactType: 'customer service',
    areaServed: 'SA',
    availableLanguage: ['Arabic', 'English'],
  }],
  paymentAccepted: 'Cash, mada, Bank transfer',
  knowsLanguage: ['ar', 'en'],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: SITE.name[lang],
  inLanguage: lang === 'ar' ? 'ar-SA' : 'en-SA',
  publisher: { '@id': abs('/#business') },
};
const jsonLd = [business, website, ...schema];
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {alternates && !noindex && (
      <>
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="ar" href={arUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </>
    )}
    <meta name="theme-color" content="#16181b" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.hero.imgAlt} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_SA'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_SA' : 'ar_SA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION && (
      <meta name="facebook-domain-verification" content={import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION} />
    )}

    <link rel="preconnect" href="https://wa.me" />
    <slot name="head" />
    {alternates && !noindex && (
      <script is:inline define:vars={{ pageLang: lang, enPath: localePath('en', path), arPath: localePath('ar', path) }}>
        /*
         * Language auto-select.
         * 1. A language the visitor picked with the switcher always wins (saved in localStorage).
         * 2. Otherwise, on English pages only: go to Arabic if the browser's first language is Arabic,
         *    or if the device is set to a Gulf time zone (Riyadh etc.) and the browser isn't English-first.
         * Search-engine bots are never redirected, so both language versions stay indexable.
         */
        (function () {
          var KEY = 'satha_lang';
          var saved = null;
          try { saved = localStorage.getItem(KEY); } catch (e) {}
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[hreflang]') : null;
            if (a) { try { localStorage.setItem(KEY, a.getAttribute('hreflang')); } catch (e) {} }
          }, true);
          if (/bot|crawl|spider|slurp|google|bing|yandex|baidu|duckduck|facebookexternalhit|lighthouse|headless/i.test(navigator.userAgent)) return;
          var want = saved;
          if (!want && pageLang === 'en') {
            var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']).map(function (l) { return String(l).toLowerCase(); });
            var first = langs[0] || '';
            var tz = '';
            try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
            var gulfTz = /^Asia\/(Riyadh|Aden|Kuwait|Qatar|Bahrain|Dubai|Muscat)$/.test(tz);
            if (first.indexOf('ar') === 0 || (gulfTz && first.indexOf('en') !== 0)) want = 'ar';
          }
          if (want && want !== pageLang && (want === 'ar' || want === 'en')) {
            location.replace((want === 'ar' ? arPath : enPath) + location.search + location.hash);
          }
        })();
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
    <ContactFloat lang={lang} wa={wa} />
    <Analytics />
  </body>
</html>
